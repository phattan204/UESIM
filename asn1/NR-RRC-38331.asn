    pollPDU             ENUMERATED {p4, p8, p16, p32, p64, p128, p256, p512, p1024, p2048, p4096, p6144, p8192, p12288, p16384, p20480, p24576, p28672, p32768, p40960, p49152, p57344, p65536, infinity},
    pollByte            ENUMERATED {kB1, kB2, kB4, kB8, kB16, kB32, kB64, kB125, kB250, kB500, kB750, kB1000, kB1250, kB1500, kB2000, kB3000, kB4000, kB5000, kB6000, kB7000, kB8000, kB9000, kB10000, kB11000, kB12000, kB13000, kB14000, kB15000, kB16000, kB17000, kB18000, kB19000, kB20000, kB22000, kB24000, kB26000, kB28000, kB30000, kB33000, kB36000, kB39000, kB42000, kB45000, kB48000, kB51000, kB54000, kB57000, kB60000, kB63000, kB66000, kB69000, kB72000, kB75000, kB78000, kB81000, kB84000, kB87000, kB90000, kB93000, kB96000, kB99000, kB102000, kB105000, kB108000, kB111000, kB114000, kB117000, kB120000, kB123000, kB126000, kB129000, kB132000, kB135000, kB138000, kB141000, kB144000, kB147000, kB150000, kB153000, kB156000, kB159000, kB162000, kB165000, kB168000, kB171000, kB174000, kB177000, kB180000, kB183000, kB186000, kB189000, kB192000, kB195000, kB198000, kB201000, kB204000, kB207000, kB210000, kB213000, kB216